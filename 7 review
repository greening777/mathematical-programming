#n3
import heapq
n,m=map(int,input().split())
L=[[] for _ in range(n+1)]

for _ in range(m):
    x,y,c=map(int,input().split())
    L[y].append([c,x])
    
P=int(input())

def find_min_val(L,p):
    dis=[float('inf') for _ in range(len(L))]
    tmp=[-1]*len(L)
    dis[P]=0
    
    pq=[(0,p)]
    last_node=[]
    
    while pq:
        curr_w, node = heapq.heappop(pq)
        
        if curr_w>dis[node]:
            continue
        
        if len(L[node])==0:
            last_node.append(node)
        
        for weight, v in L[node]:
            if weight+dis[node]<dis[v]:
                dis[v]=weight+dis[node]
                tmp[v]=node
                heapq.heappush(pq,(dis[v],v))
    
    if len(last_node)==1 and last_node[0]==P:
        print("0")
        print(P)
    
    else:
        mn=last_node[0]
        mv=dis[mn]
        
        for i in range(1, len(last_node)):
            if dis[last_node[i]]<mv:
                mv=dis[last_node[i]]
                mn=last_node[i]
                
        cidx=mn
        ret=[]
        while cidx!=-1:
            ret.append(cidx)
            cidx=tmp[cidx]
            
        print(mv)
        print(*ret)
find_min_val(L,P)
